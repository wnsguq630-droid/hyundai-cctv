rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /consultations/{document} {
      allow create: if
        request.resource.data.keys().hasAll([
          'name', 'phone', 'placeType', 'location', 'cameraCount',
          'message', 'privacyAgreed', 'createdAt', 'status'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'phone', 'placeType', 'location', 'cameraCount',
          'message', 'privacyAgreed', 'createdAt', 'status'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 30
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^0[0-9]{8,10}$')
        && request.resource.data.placeType is string
        && request.resource.data.placeType in ['매장', '사무실', '공장', '창고', '주택', '기타']
        && request.resource.data.location is string
        && request.resource.data.location.size() >= 1
        && request.resource.data.location.size() <= 100
        && request.resource.data.cameraCount is string
        && request.resource.data.cameraCount.size() >= 1
        && request.resource.data.cameraCount.size() <= 30
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1000
        && request.resource.data.privacyAgreed is bool
        && request.resource.data.privacyAgreed == true
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.status is string
        && request.resource.data.status == '신규';
      allow read, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
